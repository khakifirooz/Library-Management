<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LibraryManagementConfiguration\LibraryManagementConfiguration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="FrmBook.cs"><SubType>Form</SubType></Compile>
    <Compile Update="FrmBook.Designer.cs"><DependentUpon>FrmBook.cs</DependentUpon></Compile>
    <EmbeddedResource Update="FrmBook.resx"><DependentUpon>FrmBook.cs</DependentUpon></EmbeddedResource>
    <Compile Update="FrmRegisterMember.cs"><SubType>Form</SubType></Compile>
    <Compile Update="FrmRegisterMember.Designer.cs"><DependentUpon>FrmRegisterMember.cs</DependentUpon></Compile>
    <EmbeddedResource Update="FrmRegisterMember.resx"><DependentUpon>FrmRegisterMember.cs</DependentUpon></EmbeddedResource>
    <Compile Update="FrmUpdateMember.cs"><SubType>Form</SubType></Compile>
    <Compile Update="FrmUpdateMember.Designer.cs"><DependentUpon>FrmUpdateMember.cs</DependentUpon></Compile>
    <EmbeddedResource Update="FrmUpdateMember.resx"><DependentUpon>FrmUpdateMember.cs</DependentUpon></EmbeddedResource>
    <Compile Update="FrmManageMembers.cs"><SubType>Form</SubType></Compile>
    <Compile Update="FrmManageMembers.Designer.cs"><DependentUpon>FrmManageMembers.cs</DependentUpon></Compile>
    <EmbeddedResource Update="FrmManageMembers.resx"><DependentUpon>FrmManageMembers.cs</DependentUpon></EmbeddedResource>
    <Compile Update="FrmLoan.cs"><SubType>Form</SubType></Compile>
    <Compile Update="FrmLoan.Designer.cs"><DependentUpon>FrmLoan.cs</DependentUpon></Compile>
    <EmbeddedResource Update="FrmLoan.resx"><DependentUpon>FrmLoan.cs</DependentUpon></EmbeddedResource>
    <Compile Update="FrmAdminManagement.cs"><SubType>Form</SubType></Compile>
    <Compile Update="FrmAdminManagement.Designer.cs"><DependentUpon>FrmAdminManagement.cs</DependentUpon></Compile>
    <EmbeddedResource Update="FrmAdminManagement.resx"><DependentUpon>FrmAdminManagement.cs</DependentUpon></EmbeddedResource>
    <Compile Update="FrmCreateAdmin.cs"><SubType>Form</SubType></Compile>
    <Compile Update="FrmCreateAdmin.Designer.cs"><DependentUpon>FrmCreateAdmin.cs</DependentUpon></Compile>
    <EmbeddedResource Update="FrmCreateAdmin.resx"><DependentUpon>FrmCreateAdmin.cs</DependentUpon></EmbeddedResource>
    <Compile Update="FrmMain.cs"><SubType>Form</SubType></Compile>
    <Compile Update="FrmMain.Designer.cs"><DependentUpon>FrmMain.cs</DependentUpon></Compile>
    <EmbeddedResource Update="FrmMain.resx"><DependentUpon>FrmMain.cs</DependentUpon></EmbeddedResource>
    <Compile Update="LoginForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="LoginForm.Designer.cs"><DependentUpon>LoginForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="LoginForm.resx"><DependentUpon>LoginForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="UserProfile.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="UserProfile.Designer.cs"><DependentUpon>UserProfile.cs</DependentUpon></Compile>
    <EmbeddedResource Update="UserProfile.resx"><DependentUpon>UserProfile.cs</DependentUpon></EmbeddedResource>
    <Compile Update="PersianDatePicker.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="PersianDatePicker.Designer.cs"><DependentUpon>PersianDatePicker.cs</DependentUpon></Compile>
    <EmbeddedResource Update="PersianDatePicker.resx"><DependentUpon>PersianDatePicker.cs</DependentUpon></EmbeddedResource>
  </ItemGroup>
</Project>